---
import Base from '../layouts/Base.astro';
import Filete from '../components/Filete.astro';
import site from '../data/site.json';
const c = site.contato_pagina;
---
<Base title="Contato — Liatelier · São Paulo" description="Fale com o Liatelier: WhatsApp (11) 94503-8299, contato@liatelier.com.br ou @liatelierpinturaemceramica. Aulas, workshops, eventos e parcerias.">
  <div class="wrap topo">
    <h1>{c.titulo}</h1>
    <Filete cor="#C06B3E" largura={180} />
    <p class="lead">{c.texto}</p>
    <p class="ctas">
      <a class="btn grande" href={site.contato.whatsapp}>WhatsApp {site.contato.whatsapp_label}</a>
    </p>
    <div class="outros">
      <a href={`mailto:${site.contato.email}`}>{site.contato.email}</a>
      <span aria-hidden="true">·</span>
      <a href={site.contato.instagram}>{site.contato.instagram_handle}</a>
    </div>
    <p class="cidade">Liatelier · Perdizes, São Paulo · desde 1994</p>
  </div>
  <section class="quote">
    <div class="wrap">
      <blockquote>{c.fechamento}</blockquote>
      <Filete cor="#4E7A5F" largura={170} />
      <div class="who">Lia Mara Jorge Aloe</div>
    </div>
  </section>
</Base>
<style>
.topo{padding:56px 24px 64px;text-align:center}
.topo :global(.filete){margin:0 auto}
h1{font-size:clamp(2rem,4vw,2.8rem);margin-bottom:8px}
.lead{max-width:50ch;margin:20px auto 0;color:#5c554a;font-size:1.08rem}
.ctas{margin-top:34px}
.btn.grande{font-size:1.15rem;padding:17px 38px}
.outros{margin-top:26px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap;font-size:1.05rem}
.cidade{margin-top:30px;font-size:.8rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.quote{background:var(--areia-claro);padding:64px 0;text-align:center}
.quote blockquote{font-family:var(--font-display);font-style:italic;font-size:clamp(1.3rem,2.3vw,1.7rem);line-height:1.55;max-width:38ch;margin:0 auto 16px}
.quote :global(.filete){margin:0 auto}
.who{margin-top:14px;font-size:.85rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
</style>
