---
import '../styles/tokens.css';
import '@fontsource-variable/lora';
import '@fontsource-variable/lora/wght-italic.css';
import '@fontsource-variable/karla';
// fontes da primeira dobra pré-carregadas: o texto já nasce em Lora/Karla, sem troca visível
import karlaUrl from '@fontsource-variable/karla/files/karla-latin-wght-normal.woff2?url';
import loraUrl from '@fontsource-variable/lora/files/lora-latin-wght-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Barrado from '../components/Barrado.astro';
import site from '../data/site.json';

interface Props { title?: string; description?: string; }
const { title = site.titulo_seo, description = site.descricao_seo } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': new URL('/#liatelier', Astro.site).href,
      name: 'Liatelier',
      description: site.descricao_seo,
      image: new URL('/logo-liatelier.png', Astro.site).href,
      url: Astro.site?.href,
      telephone: '+55-11-94503-8299',
      email: site.contato.email,
      foundingDate: '1994',
      areaServed: 'São Paulo, SP, Brasil',
      address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressRegion: 'SP', addressCountry: 'BR' },
      sameAs: [site.contato.instagram],
      founder: { '@id': new URL('/#lia', Astro.site).href },
    },
    {
      '@type': 'Person',
      '@id': new URL('/#lia', Astro.site).href,
      name: 'Lia Mara Jorge Aloe',
      jobTitle: 'Artista plástica, designer e professora',
      worksFor: { '@id': new URL('/#liatelier', Astro.site).href },
    },
  ],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="font" type="font/woff2" href={karlaUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={loraUrl} crossorigin />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/logo-liatelier.png', Astro.site)} />
  </head>
  <body>
    <Barrado variante="penas" />
    <SiteHeader />
    <main id="conteudo"><slot /></main>
    <SiteFooter />
  </body>
</html>
